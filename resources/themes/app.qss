/*
 * Application stylesheet.
 * Colour tokens (@name) come from :/themes/<theme>.json, $icons is the icon set,
 * $font / $display are the text and heading families of the theme.
 *
 * Visual language: monochrome, square corners, hairline rules instead of cards,
 * serif display type for names and prices. Variants are chosen with dynamic properties:
 *   QPushButton[type="primary" | "secondary" | "ghost" | "danger" | "link" | "tab" | "index" | "swatch" | "square"]
 *   QLabel[role="display" | "h1" | "h2" | "h3" | "lead" | "muted" | "caption" | "overline" | "price" | "status" | "error"]
 *   QFrame[card="true"], QFrame#rule
 */

* {
    font-family: "$font";
    outline: none;
}

QMainWindow, QDialog, QMessageBox, QInputDialog {
    background-color: @window;
    color: @text;
}

QWidget {
    color: @text;
    font-size: 10.5pt;
}

QToolTip {
    background-color: @text;
    color: @window;
    border: none;
    padding: 5px 8px;
}

/* ---------------------------------------------------------------- Pages */

QStackedWidget#stackedWidget > QWidget,
QScrollArea#pageScroll, QScrollArea#pageScroll > QWidget > QWidget {
    background-color: @window;
}

/* ---------------------------------------------------------------- Top bar (customer) */

QFrame#topbar {
    background: transparent;
    border: none;
}

QPushButton[type="tab"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    color: @textSecondary;
    font-weight: 500;
    padding: 8px 0 7px 0;
    margin: 0;
    min-height: 0;
}
QPushButton[type="tab"]:hover {
    color: @text;
}
QPushButton[type="tab"]:checked {
    color: @text;
    border-bottom: 2px solid @text;
}
QFrame#topbar QPushButton[type="tab"],
QFrame#topbar QPushButton[type="tab"]:checked {
    border-bottom: none;
    padding: 14px 0 14px 0;
}

QLabel#navCount {
    background-color: @text;
    color: @window;
    font-size: 8pt;
    font-weight: 600;
    padding: 1px 5px;
    min-width: 8px;
}

QLabel#topbarUser {
    color: @textSecondary;
}

/* ---------------------------------------------------------------- Index (admin sidebar) */

QFrame#sidebar {
    background-color: @sidebar;
    border: none;
    border-right: 1px solid @border;
}

QPushButton[type="index"] {
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0;
    color: @textSecondary;
    text-align: left;
    padding: 7px 12px;
    min-height: 0;
    font-weight: 400;
}
QPushButton[type="index"]:hover {
    color: @text;
}
QPushButton[type="index"]:checked {
    color: @text;
    border-left: 2px solid @text;
    font-weight: 600;
}

/* ---------------------------------------------------------------- Typography */

QLabel[role="display"] {
    font-family: "$display";
    font-size: 34pt;
    font-weight: 400;
    color: @text;
}
QLabel[role="h1"] {
    font-family: "$display";
    font-size: 27pt;
    font-weight: 400;
    color: @text;
}
QLabel[role="h2"] {
    font-family: "$display";
    font-size: 18pt;
    font-weight: 500;
    color: @text;
}
QLabel[role="h3"] {
    font-size: 11pt;
    font-weight: 600;
    color: @text;
}
QLabel[role="lead"] {
    font-size: 12pt;
    color: @textSecondary;
}
QLabel[role="muted"] {
    color: @textSecondary;
}
QLabel[role="caption"] {
    color: @textMuted;
    font-size: 9pt;
}
QLabel[role="overline"] {
    color: @textMuted;
    font-size: 8.5pt;
    font-weight: 600;
}
QLabel[role="price"] {
    font-family: "$display";
    font-size: 22pt;
    font-weight: 400;
    color: @text;
}
QLabel[role="error"] {
    color: @danger;
}
QLabel[role="index"] {
    font-family: "$display";
    font-size: 13pt;
    color: @textMuted;
}

/* Status: coloured uppercase text with a short rule on the left. */
QLabel[role="status"] {
    background: transparent;
    border: none;
    border-left: 2px solid @textMuted;
    padding: 0 0 0 7px;
    font-size: 8.5pt;
    font-weight: 600;
    color: @textSecondary;
}
QLabel[role="status"][tone="success"] { border-left-color: @success; color: @success; }
QLabel[role="status"][tone="warning"] { border-left-color: @warning; color: @warning; }
QLabel[role="status"][tone="danger"]  { border-left-color: @danger;  color: @danger;  }
QLabel[role="status"][tone="accent"]  { border-left-color: @text;    color: @text;    }

/* ---------------------------------------------------------------- Surfaces */

QFrame[card="true"] {
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 0;
}
QFrame#plate, QFrame#imageStage {
    background-color: @plate;
    border: none;
    border-radius: 0;
}
QFrame#rule {
    background-color: @border;
    border: none;
    max-height: 1px;
    min-height: 1px;
}
QFrame#ruleStrong {
    background-color: @text;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

QFrame#serviceRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid @border;
}
QFrame#serviceRow:hover {
    background-color: @surfaceAlt;
}

QFrame#feedRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid @border;
}
QFrame#feedRow[unread="true"] {
    border-left: 2px solid @text;
}

QLabel#loginImage {
    background-color: @plate;
}

/* ---------------------------------------------------------------- Buttons */

QPushButton {
    background-color: transparent;
    color: @text;
    border: 1px solid @text;
    border-radius: 0;
    padding: 10px 20px;
    font-weight: 500;
    min-height: 20px;
}
QPushButton:hover {
    background-color: @surfaceHover;
}
QPushButton:pressed {
    background-color: @plateHover;
}
QPushButton:disabled {
    color: @textMuted;
    border-color: @border;
    background-color: transparent;
}

QPushButton[type="primary"] {
    background-color: @accent;
    color: @onAccent;
    border: 1px solid @accent;
}
QPushButton[type="primary"]:hover {
    background-color: @accentHover;
    border-color: @accentHover;
}
QPushButton[type="primary"]:pressed {
    background-color: @accentPressed;
    border-color: @accentPressed;
}
QPushButton[type="primary"]:disabled {
    background-color: @plate;
    color: @textMuted;
    border-color: @plate;
}

QPushButton[type="danger"] {
    color: @danger;
    border: 1px solid @danger;
}
QPushButton[type="danger"]:hover {
    background-color: @dangerSoft;
}

QPushButton[type="ghost"] {
    background: transparent;
    border: none;
    color: @textSecondary;
    padding: 8px 2px;
}
QPushButton[type="ghost"]:hover {
    background: transparent;
    color: @text;
    text-decoration: underline;
}

QPushButton[type="link"] {
    background: transparent;
    border: none;
    color: @link;
    padding: 2px 0;
    font-weight: 500;
}
QPushButton[type="link"]:hover {
    background: transparent;
    text-decoration: underline;
}

QPushButton[type="square"] {
    border: 1px solid @borderStrong;
    padding: 0;
    min-width: 38px; max-width: 38px;
    min-height: 38px; max-height: 38px;
    font-size: 13pt;
}
QPushButton[type="square"]:hover {
    border-color: @text;
    background: transparent;
}

QPushButton[type="swatch"] {
    background: transparent;
    border: 1px solid @border;
    padding: 7px 12px 7px 10px;
    text-align: left;
    font-weight: 400;
    color: @textSecondary;
}
QPushButton[type="swatch"]:hover {
    border-color: @borderStrong;
    color: @text;
    background: transparent;
}
QPushButton[type="swatch"]:checked {
    border: 1px solid @text;
    color: @text;
    font-weight: 500;
}

/* ---------------------------------------------------------------- Inputs */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit, QDateTimeEdit {
    background-color: @surface;
    color: @text;
    border: 1px solid @borderStrong;
    border-radius: 0;
    padding: 8px 10px;
    min-height: 20px;
    selection-background-color: @text;
    selection-color: @window;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QTimeEdit:hover, QDateEdit:hover, QDateTimeEdit:hover {
    border-color: @textSecondary;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTimeEdit:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border: 1px solid @text;
}
QLineEdit:read-only {
    background-color: @surfaceAlt;
    color: @textSecondary;
    border-color: @border;
}
QLineEdit[invalid="true"] {
    border: 1px solid @danger;
}

/* Search: a single underline, no box. */
QLineEdit#searchField {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @borderStrong;
    padding: 6px 4px 6px 26px;
    background-image: url(:/icons/$icons/search_small.svg);
    background-repeat: no-repeat;
    background-position: left center;
}
QLineEdit#searchField:focus {
    border-bottom: 1px solid @text;
}

QComboBox {
    padding-right: 30px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/icons/$icons/combo_down.svg);
    width: 12px;
    height: 12px;
}
QComboBox#plainCombo {
    background: transparent;
    border: none;
    border-bottom: 1px solid @borderStrong;
    padding: 6px 28px 6px 2px;
}
QComboBox#plainCombo:focus {
    border-bottom: 1px solid @text;
}
QComboBox QAbstractItemView {
    background-color: @surface;
    color: @text;
    border: 1px solid @text;
    padding: 0;
    selection-background-color: @text;
    selection-color: @window;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 0 10px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button, QTimeEdit::up-button, QDateEdit::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button, QTimeEdit::down-button, QDateEdit::down-button {
    width: 0;
    border: none;
}

QCheckBox, QRadioButton {
    spacing: 10px;
    color: @text;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @textSecondary;
    background-color: @surface;
}
QCheckBox::indicator {
    border-radius: 0;
}
QRadioButton::indicator {
    border-radius: 9px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: @text;
}
QCheckBox::indicator:checked {
    background-color: @text;
    border-color: @text;
    image: url(:/icons/$icons/check_mark.svg);
}
QRadioButton::indicator:checked {
    border: 5px solid @text;
    width: 8px;
    height: 8px;
    background-color: @surface;
}

/* ---------------------------------------------------------------- Calendar */

QCalendarWidget {
    background-color: @surface;
    border: 1px solid @border;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: @surface;
    border-bottom: 1px solid @border;
    padding: 4px;
}
QCalendarWidget QToolButton {
    color: @text;
    background: transparent;
    border: none;
    padding: 6px 10px;
    font-weight: 600;
}
QCalendarWidget QToolButton:hover {
    background-color: @surfaceHover;
}
QCalendarWidget QToolButton::menu-indicator {
    image: none;
}
QCalendarWidget QMenu {
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
}
QCalendarWidget QSpinBox {
    min-height: 0;
    padding: 2px 6px;
}
QCalendarWidget QAbstractItemView:enabled {
    background-color: @surface;
    color: @text;
    selection-background-color: @text;
    selection-color: @window;
    border: none;
}
QCalendarWidget QAbstractItemView:disabled {
    color: @textMuted;
}

/* ---------------------------------------------------------------- Lists & tables */

QListView, QListWidget {
    background: transparent;
    border: none;
    color: @text;
}
QListView::item, QListWidget::item {
    background: transparent;
}

QTableView {
    background-color: @window;
    alternate-background-color: @window;
    color: @text;
    border: none;
    border-top: 1px solid @text;
    gridline-color: @border;
    selection-background-color: @text;
    selection-color: @window;
}
QTableView::item {
    padding: 4px 10px;
    border: none;
    border-bottom: 1px solid @border;
}
QTableView::item:selected {
    background-color: @text;
    color: @window;
}
QHeaderView {
    background-color: transparent;
}
QHeaderView::section {
    background-color: @window;
    color: @textMuted;
    font-weight: 600;
    font-size: 8.5pt;
    border: none;
    border-bottom: 1px solid @borderStrong;
    padding: 10px;
}
QHeaderView::section:hover {
    color: @text;
}
QTableCornerButton::section {
    background-color: @window;
    border: none;
}

/* ---------------------------------------------------------------- Scroll */

QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: @border;
    min-height: 40px;
    min-width: 40px;
}
QScrollBar::handle:vertical {
    margin: 0 3px;
}
QScrollBar::handle:horizontal {
    margin: 3px 0;
}
QScrollBar::handle:hover {
    background-color: @borderStrong;
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

/* ---------------------------------------------------------------- Menus & group boxes */

QMenu {
    background-color: @surface;
    border: 1px solid @text;
    padding: 0;
}
QMenu::item {
    padding: 8px 18px;
}
QMenu::item:selected {
    background-color: @text;
    color: @window;
}

QGroupBox {
    border: none;
    background: transparent;
    margin: 0;
    padding: 0;
}

/* ---------------------------------------------------------------- Dialogs */

QDialogButtonBox QPushButton {
    min-width: 96px;
}
QMessageBox QLabel {
    color: @text;
}
QMessageBox QPushButton {
    min-width: 88px;
}

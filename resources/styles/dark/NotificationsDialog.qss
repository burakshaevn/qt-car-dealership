QDialog {
    background-color: #1f2329;
    color: #e8edf2;
}

QGroupBox {
    background: transparent;
    border: none;
    color: #e8edf2;
    font: 600 11pt "JetBrains Mono";
}

QScrollArea,
QScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea > QWidget > QWidget {
    background-color: #1f2329;
    border: none;
}

QPushButton,
QComboBox {
    min-height: 40px;
    max-height: 40px;
    padding: 0 14px;
    border: none;
    border-radius: 10px;
    font: 500 10pt "JetBrains Mono";
}

QPushButton {
    background-color: #2d3540;
    color: #e8edf2;
}

QPushButton:hover {
    background-color: #374251;
}

QPushButton[type="primary"] {
    background-color: #1565c0;
    color: #ffffff;
}

QPushButton[type="primary"]:hover {
    background-color: #0d47a1;
}

QComboBox {
    min-width: 220px;
    padding-left: 14px;
    padding-right: 42px;
    background-color: #252b34;
    color: #e8edf2;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 38px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/dark/combo_down.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    padding: 5px;
    border: 1px solid #3b4654;
    border-radius: 8px;
    background-color: #252b34;
    color: #e8edf2;
    selection-background-color: #35465c;
    selection-color: #ffffff;
    outline: none;
    font: 500 10pt "JetBrains Mono";
}

QComboBox QAbstractItemView::item {
    min-height: 34px;
    padding: 0 8px;
    border: none;
}

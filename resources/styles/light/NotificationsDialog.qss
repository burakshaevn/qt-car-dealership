QDialog {
    background-color: #ffffff;
    color: #1d1b20;
}

QGroupBox {
    background: transparent;
    border: none;
    color: #1d1b20;
    font: 600 11pt "JetBrains Mono";
}

QScrollArea,
QScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea > QWidget > QWidget {
    background-color: #ffffff;
    border: none;
}

QPushButton,
QComboBox {
    min-height: 40px;
    max-height: 40px;
    padding: 0 14px;
    border: none;
    border-radius: 10px;
    font: 500 10pt "JetBrains Mono";
}

QPushButton {
    background-color: #eef2f6;
    color: #1d1b20;
}

QPushButton:hover {
    background-color: #e2e8ef;
}

QPushButton[type="primary"] {
    background-color: #2196f3;
    color: #ffffff;
}

QPushButton[type="primary"]:hover {
    background-color: #1976d2;
}

QComboBox {
    min-width: 220px;
    padding-left: 14px;
    padding-right: 42px;
    background-color: #f3f6f9;
    color: #1d1b20;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 38px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/light/combo_down.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    padding: 5px;
    border: 1px solid #d9e1ea;
    border-radius: 8px;
    background-color: #ffffff;
    color: #1d1b20;
    selection-background-color: #e8f2fc;
    selection-color: #1d1b20;
    outline: none;
    font: 500 10pt "JetBrains Mono";
}

QComboBox QAbstractItemView::item {
    min-height: 34px;
    padding: 0 8px;
    border: none;
}

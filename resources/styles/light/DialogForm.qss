QDialog {
    background-color: #ffffff;
}
QLabel {
    color: #1d1b20;
    font: 500 12pt "JetBrains Mono";
}
QLabel[type="header"] {
    font: 700 16pt "JetBrains Mono";
}
QLabel#carInfo {
    background: #f6f8fb;
    border: 1px solid #d9e1ea;
    border-radius: 10px;
    padding: 12px;
    font: 700 11pt "JetBrains Mono";
}
QLabel#sectionTitle {
    font: 700 12pt "JetBrains Mono";
    margin-top: 4px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit {
    padding: 7px 10px;
    border: 1px solid #d9e1ea;
    border-radius: 8px;
    background: #fafbfd;
    color: #1d1b20;
    min-height: 28px;
    font: 10.5pt "JetBrains Mono";
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1d1b20;
    border: 1px solid #d9e1ea;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #e8f2fc;
    selection-color: #1d1b20;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    background-color: #ffffff;
}
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #e8f2fc;
}
QComboBox {
    padding-right: 38px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 34px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/icons/light/combo_down.svg);
    width: 14px;
    height: 14px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus, QDateEdit:focus {
    border: 1px solid #2196F3;
}
QGroupBox {
    color: #1d1b20;
    border: none;
    background-color: transparent;
}
QScrollArea,
QScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea > QWidget > QWidget {
    background-color: #ffffff;
    color: #1d1b20;
    border: none;
}
QCalendarWidget {
    background-color: #ffffff;
    color: #1d1b20;
    border: 1px solid #d9e1ea;
    border-radius: 10px;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #f6f8fb;
    border-bottom: 1px solid #d9e1ea;
}
QCalendarWidget QToolButton {
    min-width: 0;
    min-height: 0;
    padding: 6px 10px;
    color: #1d1b20;
    background-color: transparent;
    border: none;
    border-radius: 6px;
}
QCalendarWidget QToolButton:hover {
    background-color: #e8f2fc;
}
QCalendarWidget QMenu {
    color: #1d1b20;
    background-color: #ffffff;
    border: 1px solid #d9e1ea;
}
QCalendarWidget QSpinBox {
    min-height: 0;
    padding: 4px 8px;
}
QCalendarWidget QTableView {
    color: #1d1b20;
    background-color: #ffffff;
    alternate-background-color: #fafbfd;
    selection-color: #ffffff;
    selection-background-color: #2196F3;
    border: none;
    outline: none;
}
QCalendarWidget QTableView::item:hover {
    background-color: #e8f2fc;
    color: #1d1b20;
}
QCheckBox {
    font: 10.5pt "JetBrains Mono";
    color: #1d1b20;
    spacing: 8px;
}
QPushButton {
    background-color: #fafbfd;
    color: #1d1b20;
    border: 1px solid #d9e1ea;
    padding: 9px 14px;
    border-radius: 8px;
    font: 600 10.5pt "JetBrains Mono";
    min-width: 110px;
}
QDialogButtonBox QPushButton[type="primary"],
QPushButton[type="primary"] {
    background-color: #2196F3;
    color: #ffffff;
    border: none;
}
QDialogButtonBox QPushButton[type="primary"]:hover,
QPushButton[type="primary"]:hover {
    background-color: #1976D2;
}
QDialogButtonBox QPushButton[type="secondary"],
QPushButton[type="secondary"] {
    background-color: #fafbfd;
    color: #1d1b20;
    border: 1px solid #d9e1ea;
}
QDialogButtonBox QPushButton[type="secondary"]:hover,
QPushButton[type="secondary"]:hover {
    background-color: #eef3f8;
}
